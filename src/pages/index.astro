---
// Kova on the case-study kit, as a desktop Case Study. Narrative chapters are markup; key flows come from
// src/content/flows. Unlisted: nothing links here yet, so it asks not to be indexed.
import CaseStudy from '@xkye/case-study-kit/CaseStudy.astro';
import Story from '@xkye/case-study-kit/Story.astro';
import Chapter from '@xkye/case-study-kit/Chapter.astro';
import FlowChapter from '@xkye/case-study-kit/FlowChapter.astro';
import PrototypeFrame from '@xkye/case-study-kit/PrototypeFrame.astro';
import Tries from '@xkye/case-study-kit/Tries.astro';
import TryButton from '@xkye/case-study-kit/TryButton.astro';
import { getCollection } from 'astro:content';
import '../styles/kova.css';
const flows = (await getCollection('flows')).sort((a, b) => a.data.order - b.data.order);
---
